{
  "include_defaults": true,
  "limits": {
    "requests": 100,
    "bytes": 134217728,
    "timeout_ms": 30000,
    "retries": 3,
    "cache_seconds": 60
  },
  "sources": [
    {
      "id": "npm_private",
      "kind": "npm",
      "url": "https://packages.example.org/npm",
      "auth": {
        "mode": "required",
        "scheme": "bearer",
        "token_env": "PRIVATE_NPM_TOKEN",
        "paths": ["/npm"]
      }
    },
    {
      "id": "quay_private",
      "kind": "quay",
      "url": "https://quay.example.org",
      "registry_url": "https://quay.example.org",
      "auth": { "mode": "auto", "scheme": "bearer", "token_env": "QUAY_API_TOKEN" },
      "registry_auth": {
        "mode": "required",
        "scheme": "basic",
        "username": "organization+reader",
        "password_env": "QUAY_ROBOT_TOKEN"
      }
    },
    {
      "id": "debian_bookworm_amd64",
      "kind": "apt",
      "url": "https://deb.debian.org/debian",
      "options": { "suite": "bookworm", "component": "main", "architecture": "amd64" }
    },
    {
      "id": "ghcr_org",
      "kind": "ghcr",
      "url": "https://api.github.com",
      "registry_url": "https://ghcr.io",
      "options": { "owner": "YOUR_ORGANIZATION", "owner_type": "org" },
      "auth": { "scheme": "bearer", "token_env": "GHCR_API_TOKEN" },
      "registry_auth": { "scheme": "basic", "username": "YOUR_USERNAME", "password_env": "GHCR_PULL_TOKEN" },
      "allowed_origins": ["https://pkg-containers.githubusercontent.com"]
    },
    {
      "id": "gitlab_project",
      "kind": "gitlab",
      "url": "https://gitlab.com/api/v4",
      "registry_url": "https://registry.gitlab.com",
      "options": { "project": "gitlab-org/cluster-integration/auto-build-image" },
      "registry_auth": { "origins": ["https://gitlab.com"] },
      "allowed_origins": ["https://cdn.registry.gitlab-static.net"]
    },
    {
      "id": "hex_private",
      "kind": "hex",
      "url": "https://hex.pm",
      "registry_url": "https://repo.hex.pm",
      "options": { "repository": "YOUR_REPOSITORY" },
      "auth": { "mode": "required", "scheme": "token", "token_env": "HEX_API_KEY" }
    },
    {
      "id": "nixpkgs_public",
      "kind": "nixpkgs",
      "url": "https://github.com/NixOS/nixpkgs",
      "options": { "revision": "REPLACE_WITH_A_40_CHARACTER_COMMIT", "system": "x86_64-linux" }
    }
  ]
}
